package tests;

use ecosystem::redis as client;
use ecosystem::redis::commands;
use std::testing;
use std::panic;

#[test]
fn public_custom_transport_callbacks_cross_module_boundary() -> () {
    let bytes = "%1\r\n+proto\r\n:3\r\n+PONG\r\n".to_bytes();
    let offset = Ref::new(0);
    let closed = Ref::new(false);
    let transport = client::Transport::new(
        |buffer, operation| {
            testing::assert_some(operation.timeout());
            let mut count = 0;
            while count < buffer.len() && offset.get() < bytes.len() {
                buffer[count] = bytes[offset.get()];
                offset.set(offset.get() + 1);
                count += 1;
            }
            Result::Ok(count)
        },
        |_, _| Result::Ok(()),
        || {
            closed.set(true);
            Result::Ok(())
        },
        || closed.get(),
    );
    let connection = testing::expect_ok(
        client::Connection::from_transport(
            transport,
            client::ConnectionOptions::standard(),
            client::Operation::new(),
        ),
        "custom connection",
    );
    testing::assert_eq(
        testing::expect_ok(
            connection.execute(
                testing::expect_ok(commands::ping(), "ping"),
                client::Operation::new(),
            ),
            "pong",
        ),
        "PONG",
    );
    testing::assert_ok(connection.close());
    testing::assert(closed.get());
}

#[test]
fn published_watch_callback_panic_closes_owned_transport() -> () {
    let bytes = "%1\r\n+proto\r\n:3\r\n+OK\r\n".to_bytes();
    let offset = Ref::new(0);
    let closed = Ref::new(false);
    let transport = client::Transport::new(
        |buffer, _| {
            let mut count = 0;
            while count < buffer.len() && offset.get() < bytes.len() {
                buffer[count] = bytes[offset.get()];
                offset.set(offset.get() + 1);
                count += 1;
            }
            Result::Ok(count)
        },
        |_, _| Result::Ok(()),
        || {
            closed.set(true);
            Result::Ok(())
        },
        || closed.get(),
    );
    let connection = testing::expect_ok(
        client::Connection::from_transport(
            transport,
            client::ConnectionOptions::standard(),
            client::Operation::new(),
        ),
        "connection",
    );
    let result = panic::catch(
        || connection.compare_and_set(
            Vec::from_array([client::Blob::from_string("key")]),
            client::Pipeline::new(),
            |_| panic::raise("consumer callback panic"),
            client::Operation::new(),
        ),
    );
    testing::assert(result.is_err());
    testing::assert(closed.get());
    testing::assert(connection.is_closed());
}
