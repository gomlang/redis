package tests;

use ecosystem::redis as client;
use ecosystem::redis::commands;
use std::testing;
use std::panic;

#[test]
fn public_custom_transport_callbacks_cross_module_boundary() -> () {
    let bytes = "%1\r\n+proto\r\n:3\r\n+PONG\r\n".to_bytes();
    let offset = Ref::new(0);
    let closed = Ref::new(false);
    let transport = client::Transport::new(
        |buffer, operation| {
            testing::assert_some(operation.timeout());
            let mut count = 0;
            while count < buffer.len() && offset.get() < bytes.len() {
                buffer[count] = bytes[offset.get()];
                offset.set(offset.get() + 1);
                count += 1;
            }
            Result::Ok(count)
        },
        |_, _| Result::Ok(()),
        || {
            closed.set(true);
            Result::Ok(())
        },
        || closed.get(),
    );
    let connection = testing::expect_ok(
        client::Connection::from_transport(
            transport,
            client::ConnectionOptions::standard(),
            client::Operation::new(),
        ),
        "custom connection",
    );
    testing::assert_eq(
        testing::expect_ok(
            connection.execute(
                testing::expect_ok(commands::ping(), "ping"),
                client::Operation::new(),
            ),
            "pong",
        ),
        "PONG",
    );
    testing::assert_ok(connection.close());
    testing::assert(closed.get());
}

#[test]
fn published_watch_callback_panic_closes_owned_transport() -> () {
    let bytes = "%1\r\n+proto\r\n:3\r\n+OK\r\n".to_bytes();
    let offset = Ref::new(0);
    let closed = Ref::new(false);
    let transport = client::Transport::new(
        |buffer, _| {
            let mut count = 0;
            while count < buffer.len() && offset.get() < bytes.len() {
                buffer[count] = bytes[offset.get()];
                offset.set(offset.get() + 1);
                count += 1;
            }
            Result::Ok(count)
        },
        |_, _| Result::Ok(()),
        || {
            closed.set(true);
            Result::Ok(())
        },
        || closed.get(),
    );
    let connection = testing::expect_ok(
        client::Connection::from_transport(
            transport,
            client::ConnectionOptions::standard(),
            client::Operation::new(),
        ),
        "connection",
    );
    let result = panic::catch(
        || connection.compare_and_set(
            Vec::from_array([client::Blob::from_string("key")]),
            client::Pipeline::new(),
            |_| panic::raise("consumer callback panic"),
            client::Operation::new(),
        ),
    );
    testing::assert(result.is_err());
    testing::assert(closed.get());
    testing::assert(connection.is_closed());
}

#[test]
fn published_pool_restores_reservation_after_connector_unwind() -> () {
    let calls = Ref::new(0);
    let pool = testing::expect_ok(
        client::Pool::new(
            client::PoolOptions {
                max_connections: 1,
                max_idle: 1,
                ..client::PoolOptions::standard(),
            },
            |_| {
                calls.set(calls.get() + 1);
                if calls.get() == 1 {
                    panic::raise("consumer connector panic");
                }
                Result::Err(
                    client::Error {
                        kind: client::ErrorKind::Io,
                        offset: 0,
                        message: "consumer connector failed",
                        server: Option::None,
                        io_kind: Option::None,
                        index: Option::None,
                        may_have_executed: false,
                        partial: Vec::new(),
                    },
                )
            },
        ),
        "consumer pool",
    );
    defer {
        let _ = pool.close();
    };
    testing::assert(panic::catch(|| pool.acquire(client::Operation::new())).is_err());
    testing::assert_eq(pool.stats().opening, 0);
    let problem = testing::expect_err(
        pool.acquire(client::Operation::new()),
        "second connector returned error",
    );
    testing::assert_eq(problem.message, "consumer connector failed");
    testing::assert_eq(calls.get(), 2);
    testing::assert_eq(pool.stats().opening, 0);
}

#[test]
fn published_lease_release_panic_reclaims_capacity_and_closes_transport() -> () {
    let inspect_panics = Ref::new(false);
    let closes = Ref::new(0);
    let pool = testing::expect_ok(
        client::Pool::new(
            client::PoolOptions {
                max_connections: 1,
                max_idle: 1,
                ..client::PoolOptions::standard(),
            },
            |operation| {
                let bytes = "%1\r\n+proto\r\n:3\r\n+PONG\r\n".to_bytes();
                let offset = Ref::new(0);
                client::Connection::from_transport(
                    client::Transport::new(
                        |buffer, _| {
                            let mut count = 0;
                            while count < buffer.len() && offset.get() < bytes.len() {
                                buffer[count] = bytes[offset.get()];
                                offset.set(offset.get() + 1);
                                count += 1;
                            }
                            Result::Ok(count)
                        },
                        |_, _| Result::Ok(()),
                        || {
                            closes.set(closes.get() + 1);
                            Result::Ok(())
                        },
                        || {
                            if inspect_panics.get() {
                                panic::raise("consumer release panic");
                            }
                            false
                        },
                    ),
                    client::ConnectionOptions::standard(),
                    operation,
                )
            },
        ),
        "pool",
    );
    defer {
        let _ = pool.close();
    };
    let lease = testing::expect_ok(pool.acquire(client::Operation::new()), "lease");
    inspect_panics.set(true);
    testing::assert(panic::catch(|| lease.release()).is_err());
    testing::assert_eq(closes.get(), 1);
    testing::assert_eq(pool.stats().leased, 0);
    testing::assert_ok(lease.release());
    inspect_panics.set(false);
    testing::assert_eq(
        testing::expect_ok(
            pool.execute(testing::expect_ok(commands::ping(), "ping"), client::Operation::new()),
            "replacement",
        ),
        "PONG",
    );
}
