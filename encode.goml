package redis;

use std::math;

// Validation and byte emission share one traversal. The counter never retains
// argument bytes while a pipeline waits to acquire its connection.

trait EncodingOutput {
    fn len(self: Self) -> isize;
    fn append(self: Self, value: Slice[u8]) -> ();
}

struct EncodedBytes {
    bytes: Vec[u8],
}

impl EncodingOutput for EncodedBytes {
    fn len(self: EncodedBytes) -> isize {
        self.bytes.len()
    }

    fn append(self: EncodedBytes, value: Slice[u8]) -> () {
        for byte in value {
            self.bytes.push(byte);
        }
    }
}

struct EncodedLength {
    length: Ref[isize],
}

impl EncodingOutput for EncodedLength {
    fn len(self: EncodedLength) -> isize {
        self.length.get()
    }

    fn append(self: EncodedLength, value: Slice[u8]) -> () {
        self.length.set(self.length.get() + value.len());
    }
}

struct Writer[O] {
    limits: Limits,
    output: O,
    values: Ref[isize],
}

impl[O: EncodingOutput] Writer[O] {
    fn bytes(self: Writer[O], value: Slice[u8]) -> Result[(), Error] {
        if value.len() > self.limits.max_frame_bytes - self.output.len() {
            return Result::Err(
                error(ErrorKind::Limit, self.output.len(), "encoded RESP exceeds frame limit"),
            )
        }
        self.output.append(value);
        Result::Ok(())
    }

    fn text(self: Writer[O], value: string) -> Result[(), Error] {
        self.bytes(value.to_bytes().as_slice())
    }

    fn line(self: Writer[O], tag: string, data: Slice[u8]) -> Result[(), Error] {
        if data.len() > self.limits.max_line_bytes {
            return Result::Err(
                error(ErrorKind::Limit, self.output.len(), "RESP line exceeds limit"),
            )
        }
        for byte in data {
            if byte == 13 || byte == 10 {
                return Result::Err(
                    error(
                        ErrorKind::Protocol,
                        self.output.len(),
                        "simple RESP value contains CR or LF",
                    ),
                )
            }
        }
        self.text(tag)?;
        self.bytes(data)?;
        self.text("\r\n")
    }

    fn header(self: Writer[O], tag: string, value: string) -> Result[(), Error] {
        self.line(tag, value.to_bytes().as_slice())
    }

    fn blob(self: Writer[O], tag: string, data: Vec[u8]) -> Result[(), Error] {
        if data.len() > self.limits.max_blob_bytes {
            return Result::Err(error(ErrorKind::Limit, self.output.len(), "blob exceeds limit"))
        }
        self.header(tag, data.len().to_string())?;
        self.bytes(data.as_slice())?;
        self.text("\r\n")
    }

    fn collection(self: Writer[O], tag: string, values: Vec[Value], depth: isize) -> Result[
        (),
        Error,
    ] {
        if values.len() > self.limits.max_elements {
            return Result::Err(
                error(ErrorKind::Limit, self.output.len(), "aggregate exceeds element limit"),
            )
        }
        self.header(tag, values.len().to_string())?;
        for value in values {
            self.value(value, depth + 1)?;
        }
        Result::Ok(())
    }

    fn mapping(self: Writer[O], tag: string, fields: Vec[(Value, Value)], depth: isize) -> Result[
        (),
        Error,
    ] {
        if fields.len() > self.limits.max_elements {
            return Result::Err(
                error(ErrorKind::Limit, self.output.len(), "map exceeds element limit"),
            )
        }
        self.header(tag, fields.len().to_string())?;
        for (key, value) in fields {
            self.value(key, depth + 1)?;
            self.value(value, depth + 1)?;
        }
        Result::Ok(())
    }

    fn value(self: Writer[O], value: Value, depth: isize) -> Result[(), Error] {
        if depth > self.limits.max_depth || self.values.get() >= self.limits.max_values {
            return Result::Err(
                error(ErrorKind::Limit, self.output.len(), "RESP nesting or value limit exceeded"),
            )
        }
        self.values.set(self.values.get() + 1);
        match value {
            Value::Simple(value) => self.line("+", value.as_slice()),
            Value::SimpleError(value) => self.line("-", value.as_slice()),
            Value::Integer(value) => self.header(":", value.to_string()),
            Value::Bulk(value) => self.blob("$", value),
            Value::NullBulk => self.header("$", "-1"),
            Value::NullArray => self.header("*", "-1"),
            Value::Null => self.header("_", ""),
            Value::Boolean(value) => self.header(
                "#",
                if value {
                    "t"
                } else {
                    "f"
                },
            ),
            Value::Double(value) => self.header(
                ",",
                if math::is_nan(value) {
                    "nan"
                } else if math::is_infinite(value) {
                    if value < 0.0 {
                        "-inf"
                    } else {
                        "inf"
                    }
                } else {
                    value.to_string()
                },
            ),
            Value::BigNumber(value) => {
                if !decimal(value, true) {
                    return Result::Err(
                        error(ErrorKind::Protocol, self.output.len(), "invalid big number"),
                    )
                }
                self.header("(", value)
            },
            Value::BlobError(value) => self.blob("!", value),
            Value::Verbatim(format, value) => {
                if format.byte_len() != 3 {
                    return Result::Err(
                        error(
                            ErrorKind::Protocol,
                            self.output.len(),
                            "verbatim format must contain three ASCII bytes",
                        ),
                    )
                }
                for byte in format.to_bytes() {
                    if byte < 32 || byte > 126 {
                        return Result::Err(
                            error(ErrorKind::Protocol, self.output.len(), "invalid verbatim format"),
                        )
                    }
                }
                if self.limits.max_blob_bytes < 4 || value.len() > self.limits.max_blob_bytes - 4 {
                    return Result::Err(
                        error(
                            ErrorKind::Limit,
                            self.output.len(),
                            "verbatim payload exceeds blob limit",
                        ),
                    )
                }
                self.header("=", (value.len() + 4).to_string())?;
                self.text(format)?;
                self.text(":")?;
                self.bytes(value.as_slice())?;
                self.text("\r\n")
            },
            Value::Array(values) => self.collection("*", values, depth),
            Value::Set(values) => self.collection("~", values, depth),
            Value::Push(values) => {
                let frame = Aggregate { tag: 62, expected: Option::Some(values.len()), values };
                let _ = aggregate_value(frame, self.output.len())?;
                self.collection(">", values, depth)
            },
            Value::Map(fields) => self.mapping("%", fields, depth),
            Value::Attribute(fields, value) => {
                self.mapping("|", fields, depth)?;
                self.value(value, depth + 1)
            },
        }
    }
}

pub fn encode_with_limits(value: Value, limits: Limits) -> Result[Vec[u8], Error] {
    limits.validate()?;
    let writer = Writer { limits, output: EncodedBytes { bytes: Vec::new() }, values: Ref::new(0) };
    writer.value(value, 0)?;
    Result::Ok(writer.output.bytes)
}

pub fn encode(value: Value) -> Result[Vec[u8], Error] {
    encode_with_limits(value, Limits::standard())
}

fn encoded_length(value: Value, limits: Limits) -> Result[isize, Error] {
    limits.validate()?;
    let output = EncodedLength { length: Ref::new(0) };
    let writer = Writer { limits, output, values: Ref::new(0) };
    writer.value(value, 0)?;
    Result::Ok(output.len())
}
