package tests;

use ecosystem::redis;
use ecosystem::redis::commands;
use std::io;
use std::task;
use std::time;
use std::testing;
use std::panic;

struct Scripted {
    source: Vec[u8],
    cursor: Ref[isize],
    writes: Vec[Vec[u8]],
    closes: Ref[isize],
    bad_read: Ref[bool],
    panic_exec: Ref[bool],
    panic_reply: Ref[bool],
    panic_close: Ref[bool],
    panic_closed: Ref[bool],
}

impl Scripted {
    fn new(source: string) -> Scripted {
        Scripted {
            source: source.to_bytes(),
            cursor: Ref::new(0),
            writes: Vec::new(),
            closes: Ref::new(0),
            bad_read: Ref::new(false),
            panic_exec: Ref::new(false),
            panic_reply: Ref::new(false),
            panic_close: Ref::new(false),
            panic_closed: Ref::new(false),
        }
    }

    fn transport(self: Scripted) -> redis::Transport {
        redis::Transport::new(
            |buffer, operation| {
                testing::assert_some(operation.timeout());
                if self.panic_reply.get() && self.writes.len() > 1 {
                    panic::raise("stateful setup reply panic");
                }
                if self.bad_read.get() {
                    return Result::Ok(buffer.len() + 1)
                }
                let mut count = 0;
                while count < buffer.len() && count < 3 && self.cursor.get() < self.source.len() {
                    buffer[count] = self.source[self.cursor.get()];
                    self.cursor.set(self.cursor.get() + 1);
                    count += 1;
                }
                Result::Ok(count)
            },
            |buffer, operation| {
                testing::assert_some(operation.timeout());
                self.writes.push(buffer.to_vec());
                let (_, command) = string_from_utf8(buffer.to_vec());
                if self.panic_exec.get() && command.contains("EXEC") {
                    panic::raise("EXEC transport panic");
                }
                Result::Ok(())
            },
            || {
                self.closes.set(self.closes.get() + 1);
                if self.panic_close.get() {
                    panic::raise("transport close panic");
                }
                Result::Ok(())
            },
            || {
                if self.panic_closed.get() {
                    panic::raise("transport is_closed panic");
                }
                self.closes.get() > 0
            },
        )
    }
}

#[test]
fn injected_transport_runs_handshake_pipeline_and_owns_close() -> () {
    let script = Scripted::new("%1\r\n+proto\r\n:3\r\n+OK\r\n+PONG\r\n$3\r\nhey\r\n");
    let options = redis::ConnectionOptions { database: 2, ..redis::ConnectionOptions::standard() };
    let connection = testing::expect_ok(
        redis::Connection::from_transport(script.transport(), options, redis::Operation::new()),
        "custom transport",
    );
    let pipeline = redis::Pipeline::new();
    let ping = pipeline.queue(testing::expect_ok(commands::ping(), "ping"));
    let echo = pipeline.queue(testing::expect_ok(commands::echo("hey"), "echo"));
    let replies = testing::expect_ok(
        connection.pipeline(pipeline, redis::Operation::new()),
        "pipeline",
    );
    testing::assert_eq(testing::expect_ok(replies.get(ping), "pong"), "PONG");
    testing::assert_eq(
        testing::expect_ok(testing::expect_ok(replies.get(echo), "echo").text(), "text"),
        "hey",
    );
    testing::assert_eq(script.writes.len(), 3);
    testing::assert_ok(connection.close());
    testing::assert_ok(connection.close());
    testing::assert_eq(script.closes.get(), 1);
    testing::assert(connection.is_closed());
}

#[test]
fn injected_transport_validates_counts_and_closes_on_all_setup_failures() -> () {
    let script = Scripted::new("%1\r\n+proto\r\n:3\r\n");
    let connection = testing::expect_ok(
        redis::Connection::from_transport(
            script.transport(),
            redis::ConnectionOptions::standard(),
            redis::Operation::new(),
        ),
        "connection",
    );
    script.bad_read.set(true);
    let problem = testing::expect_err(
        connection.execute(testing::expect_ok(commands::ping(), "ping"), redis::Operation::new()),
        "invalid transport count",
    );
    testing::assert_eq(problem.kind, redis::ErrorKind::Io);
    testing::assert(problem.may_have_executed);
    testing::assert_eq(script.closes.get(), 1);
    let rejected = Scripted::new("-WRONGPASS denied\r\n");
    testing::assert_err(
        redis::Connection::from_transport(
            rejected.transport(),
            redis::ConnectionOptions::standard(),
            redis::Operation::new(),
        ),
    );
    testing::assert_eq(rejected.closes.get(), 1);
    let invalid = Scripted::new("");
    testing::assert_err(
        redis::Connection::from_transport(
            invalid.transport(),
            redis::ConnectionOptions { read_chunk_bytes: 0, ..redis::ConnectionOptions::standard() },
            redis::Operation::new(),
        ),
    );
    testing::assert_eq(invalid.closes.get(), 1);
    testing::assert_eq(invalid.writes.len(), 0);
}

#[test]
fn dialer_shares_setup_deadline_and_precancel_does_not_dial() -> () {
    let calls = Ref::new(0);
    task::scope(
        |scope| {
            scope.cancel();
            let problem = testing::expect_err(
                redis::Connection::dial(
                    redis::ConnectionOptions::standard(),
                    redis::Operation::new().with_cancel(scope.token()),
                    |_| {
                        calls.set(calls.get() + 1);
                        Result::Ok(Scripted::new("").transport())
                    },
                ),
                "precancel",
            );
            testing::assert_eq(problem.kind, redis::ErrorKind::Cancelled);
        },
    );
    testing::assert_eq(calls.get(), 0);
    let script = Scripted::new("%1\r\n+proto\r\n:3\r\n");
    let problem = testing::expect_err(
        redis::Connection::dial(
            redis::ConnectionOptions::standard(),
            redis::Operation::new().with_timeout(time::Duration::from_milliseconds(10)),
            |operation| {
                testing::assert_some(operation.timeout());
                time::sleep(time::Duration::from_milliseconds(25));
                Result::Ok(script.transport())
            },
        ),
        "dial timeout",
    );
    testing::assert_eq(problem.kind, redis::ErrorKind::Timeout);
    testing::assert_eq(script.closes.get(), 1);
    testing::assert_eq(script.writes.len(), 0);
    let problem = testing::expect_err(
        redis::Connection::dial(
            redis::ConnectionOptions::standard(),
            redis::Operation::new(),
            |_| Result::Err(
                io::Error::new(
                    io::ErrorKind::PermissionDenied,
                    "dial",
                    Option::None,
                    Option::None,
                    "denied",
                ),
            ),
        ),
        "dial failure",
    );
    testing::assert(problem.io_kind == Option::Some(io::ErrorKind::PermissionDenied));
}

#[test]
fn watched_callback_panics_close_before_releasing_connection_state() -> () {
    let script = Scripted::new("%1\r\n+proto\r\n:3\r\n+OK\r\n");
    let connection = testing::expect_ok(
        redis::Connection::from_transport(
            script.transport(),
            redis::ConnectionOptions::standard(),
            redis::Operation::new(),
        ),
        "connection",
    );
    let unwound = Ref::new(false);
    let caught = panic::catch(
        || connection.compare_and_set(
            Vec::from_array([redis::Blob::from_string("key")]),
            redis::Pipeline::new(),
            |_| {
                defer unwound.set(true);
                panic::raise("WATCH callback panic")
            },
            redis::Operation::new(),
        ),
    );
    testing::assert(caught.is_err());
    testing::assert(unwound.get());
    testing::assert(connection.is_closed());
    testing::assert_eq(script.closes.get(), 1);
    let problem = testing::expect_err(
        connection.execute(testing::expect_ok(commands::ping(), "ping"), redis::Operation::new()),
        "closed after panic",
    );
    testing::assert_eq(problem.kind, redis::ErrorKind::Closed);
    testing::assert(!problem.may_have_executed);
    testing::assert_eq(script.writes.len(), 2);
}

#[test]
fn watched_callback_errors_unwatch_and_leave_connection_reusable() -> () {
    let script = Scripted::new("%1\r\n+proto\r\n:3\r\n+OK\r\n+OK\r\n+PONG\r\n");
    let connection = testing::expect_ok(
        redis::Connection::from_transport(
            script.transport(),
            redis::ConnectionOptions::standard(),
            redis::Operation::new(),
        ),
        "connection",
    );
    let error = testing::expect_err(
        connection.compare_and_set(
            Vec::from_array([redis::Blob::from_string("key")]),
            redis::Pipeline::new(),
            |_| Result::Err(redis::Error::new(redis::ErrorKind::Type, "application rejected")),
            redis::Operation::new(),
        ),
        "application error",
    );
    testing::assert_eq(error.message, "application rejected");
    testing::assert(!connection.is_closed());
    testing::assert_eq(
        testing::expect_ok(
            connection.execute(
                testing::expect_ok(commands::ping(), "ping"),
                redis::Operation::new(),
            ),
            "reused connection",
        ),
        "PONG",
    );
    let (_, unwatch) = string_from_utf8(script.writes[2]);
    testing::assert(unwatch.contains("UNWATCH"));
    testing::assert_ok(connection.close());
}

#[test]
fn transaction_transport_panic_closes_active_multi_scope() -> () {
    let script = Scripted::new("%1\r\n+proto\r\n:3\r\n+OK\r\n");
    let connection = testing::expect_ok(
        redis::Connection::from_transport(
            script.transport(),
            redis::ConnectionOptions::standard(),
            redis::Operation::new(),
        ),
        "connection",
    );
    script.panic_exec.set(true);
    let caught = panic::catch(
        || connection.transaction(redis::Pipeline::new(), redis::Operation::new()),
    );
    testing::assert(caught.is_err());
    testing::assert(connection.is_closed());
    testing::assert_eq(script.closes.get(), 1);
}

#[test]
fn pool_evicts_a_lease_after_a_watched_callback_panics() -> () {
    let first = Scripted::new("%1\r\n+proto\r\n:3\r\n+OK\r\n");
    let second = Scripted::new("%1\r\n+proto\r\n:3\r\n+PONG\r\n");
    let calls = Ref::new(0);
    let pool = testing::expect_ok(
        redis::Pool::new(
            redis::PoolOptions {
                max_connections: 1,
                max_idle: 1,
                health_check: redis::HealthCheck::Never,
                ..redis::PoolOptions::standard(),
            },
            |operation| {
                calls.set(calls.get() + 1);
                let script: Scripted = if calls.get() == 1 {
                    first
                } else {
                    second
                };
                redis::Connection::from_transport(
                    script.transport(),
                    redis::ConnectionOptions::standard(),
                    operation,
                )
            },
        ),
        "pool",
    );
    defer {
        let _ = pool.close();
    };
    let lease = testing::expect_ok(pool.acquire(redis::Operation::new()), "lease");
    let caught = panic::catch(
        || lease.compare_and_set(
            Vec::from_array([redis::Blob::from_string("key")]),
            redis::Pipeline::new(),
            |_| panic::raise("pooled WATCH panic"),
            redis::Operation::new(),
        ),
    );
    testing::assert(caught.is_err());
    testing::assert_ok(lease.release());
    testing::assert_eq(pool.stats().idle, 0);
    testing::assert_eq(first.closes.get(), 1);
    testing::assert_eq(
        testing::expect_ok(
            pool.execute(testing::expect_ok(commands::ping(), "ping"), redis::Operation::new()),
            "replacement connection",
        ),
        "PONG",
    );
    testing::assert_eq(calls.get(), 2);
}

#[test]
fn stateful_setup_acknowledgement_panics_close_connections() -> () {
    for watch in Vec::from_array([false, true]) {
        let script = Scripted::new("%1\r\n+proto\r\n:3\r\n+OK\r\n");
        let connection = testing::expect_ok(
            redis::Connection::from_transport(
                script.transport(),
                redis::ConnectionOptions::standard(),
                redis::Operation::new(),
            ),
            "connection",
        );
        script.panic_reply.set(true);
        let caught = panic::catch(
            || {
                if watch {
                    connection.compare_and_set(
                        Vec::from_array([redis::Blob::from_string("key")]),
                        redis::Pipeline::new(),
                        |_| Result::Ok(redis::Pipeline::new()),
                        redis::Operation::new(),
                    )
                } else {
                    connection.transaction(redis::Pipeline::new(), redis::Operation::new())
                }
            },
        );
        testing::assert(caught.is_err());
        testing::assert(connection.is_closed());
        testing::assert_eq(script.closes.get(), 1);
        testing::assert_eq(script.writes.len(), 2);
    }
}

#[test]
fn rejected_stateful_setup_keeps_connections_reusable() -> () {
    for watch in Vec::from_array([false, true]) {
        let script = Scripted::new("%1\r\n+proto\r\n:3\r\n-ERR setup rejected\r\n+PONG\r\n");
        let connection = testing::expect_ok(
            redis::Connection::from_transport(
                script.transport(),
                redis::ConnectionOptions::standard(),
                redis::Operation::new(),
            ),
            "connection",
        );
        let result = if watch {
            connection.compare_and_set(
                Vec::from_array([redis::Blob::from_string("key")]),
                redis::Pipeline::new(),
                |_| Result::Ok(redis::Pipeline::new()),
                redis::Operation::new(),
            )
        } else {
            connection.transaction(redis::Pipeline::new(), redis::Operation::new())
        };
        let problem = testing::expect_err(result, "setup rejected");
        testing::assert_eq(problem.kind, redis::ErrorKind::Server);
        testing::assert(!connection.is_closed());
        testing::assert_eq(
            testing::expect_ok(
                connection.execute(
                    testing::expect_ok(commands::ping(), "ping"),
                    redis::Operation::new(),
                ),
                "connection remains synchronized",
            ),
            "PONG",
        );
        testing::assert_ok(connection.close());
    }
}
